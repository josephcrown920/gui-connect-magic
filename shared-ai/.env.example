OPENROUTER_API_KEY=
FAL_KEY=
# Generate one client configuration with: node shared-ai/scripts/create-app.mjs reel
# Paste only the applications JSON here, and store the app key in that app's SERVER settings.
SHARED_AI_APPS_JSON=
SHARED_AI_DATABASE=/data/shared-ai.sqlite
PORT=8787
# Optional existing providers:
LOVABLE_API_KEY=
ARK_API_KEY=

# Ollama: local daemon, or a protected HTTPS endpoint reachable by this server.
# Cloud tags require ollama signin on that daemon. Local Qwen needs ollama pull.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only needed when your remote endpoint requires a bearer credential.
OLLAMA_API_KEY=
