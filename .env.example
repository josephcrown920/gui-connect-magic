# Server-only. Add values in your host's secure runtime secret settings.
# Never prefix these with VITE_ and never commit populated secret files.
OPENROUTER_API_KEY=
FAL_KEY=
# Owner access code: choose at least 24 random characters.
STUDIO_ACCESS_TOKEN=
# Optional existing Lovable gateway integration; managed by Lovable when enabled.
LOVABLE_API_KEY=
# Optional ModelArk integration. Region and model/endpoint must match your account.
ARK_API_KEY=
# Optional planning model overrides. Only change to supported model IDs.
STUDIO_ASTRA_MODEL=openai/gpt-6-astra
STUDIO_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
STUDIO_CLAUDE_MODEL=anthropic/claude-sonnet-5
STUDIO_QWEN_MODEL=qwen/qwen3.8-flash
STUDIO_MINIMAX_MODEL=minimax/minimax-m3
# To use one standalone backend across projects, put provider keys ONLY there.
# This studio only needs these client-server settings plus STUDIO_ACCESS_TOKEN:
SHARED_AI_BASE_URL=
SHARED_AI_APP_ID=
SHARED_AI_APP_KEY=

# Ollama: local daemon, or a protected HTTPS endpoint reachable by this server.
# Cloud tags require ollama signin on that daemon. Local Qwen needs ollama pull.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Only needed when your remote endpoint requires a bearer credential.
OLLAMA_API_KEY=
